# ============================================================
# .env.example — EnterpriseLead AI — Copy to .env and fill in
# ============================================================

# ── App ──────────────────────────────────────────────────────
DEBUG=False
ENVIRONMENT=development
PORT=8000

# ── Database (REQUIRED) ──────────────────────────────────────
# Get from Railway: https://railway.app → New Project → PostgreSQL
# Or Supabase: https://supabase.com → New Project → Settings → Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Claude AI (REQUIRED) ─────────────────────────────────────
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx

# ── HubSpot CRM (OPTIONAL — Day 5) ──────────────────────────
# Get from: HubSpot → Settings → Integrations → Private Apps → Create
HUBSPOT_API_KEY=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Alert System (OPTIONAL — Day 5) ─────────────────────────
# Score threshold for triggering hot lead alerts (default: 75)
LEAD_SCORE_THRESHOLD=75

# Twilio SMS (optional) — https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_FROM=+1XXXXXXXXXX
SALES_ALERT_PHONE=+91XXXXXXXXXX

# SendGrid Email (optional) — https://sendgrid.com
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SALES_EMAIL=sales@yourcompany.com
