# ================================================
# .env.example — Copy to .env and fill in values
# ================================================

# === DATABASE ===
DATABASE_URL=postgresql://user:password@localhost:5432/flowzint_bot

# === CLAUDE API (Anthropic) ===
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# === HUBSPOT CRM ===
# Get from: HubSpot → Settings → Integrations → Private Apps
HUBSPOT_API_KEY=pat-na1-xxxxxxxxxxxxxxxxxxxx

# === ALERT SYSTEM (Optional) ===
# Twilio (SMS alerts for hot leads)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_FROM=+1xxxxxxxxxx
SALES_ALERT_PHONE=+91xxxxxxxxxx

# SendGrid (Email alerts)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
SALES_EMAIL=sales@yourcompany.com

# === APP SETTINGS ===
DEBUG=True
PORT=8000
ENVIRONMENT=development
LEAD_SCORE_THRESHOLD=75
